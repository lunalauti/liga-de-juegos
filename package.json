{
  "name": "liga-de-juegos",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @liga/web",
    "dev:api": "npm run dev -w @liga/api",
